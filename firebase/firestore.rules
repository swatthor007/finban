rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }

    // Link ids are deterministic: {elder_uid}_{caretaker_uid} (rules cannot run queries).
    function linked(elder, caretaker) {
      return exists(/databases/$(db)/documents/links/$(elder + '_' + caretaker));
    }
    function allLinked(elder, uids) {
      return (uids.size() < 1 || linked(elder, uids[0]))
          && (uids.size() < 2 || linked(elder, uids[1]))
          && (uids.size() < 3 || linked(elder, uids[2]));
    }

    // Owner-only, which also makes fcm_tokens owner-only.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /links/{id} {
      allow read: if signedIn()
        && (request.auth.uid == resource.data.elder_uid
            || request.auth.uid == resource.data.caretaker_uid);
      allow write: if false;
    }

    match /pair_codes/{code} {
      allow read, write: if false;
    }

    match /alerts/{id} {
      allow create: if signedIn()
        && request.resource.data.elder_uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.trigger in ['pause_yes', 'already_paid', 'manual']
        && request.resource.data.severity in ['high', 'careful', 'none']
        && request.resource.data.caretaker_uids is list
        && request.resource.data.caretaker_uids.size() <= 3
        && allLinked(request.auth.uid, request.resource.data.caretaker_uids);
      allow read: if signedIn()
        && (resource.data.elder_uid == request.auth.uid
            || request.auth.uid in resource.data.caretaker_uids);
      // TODO(hackathon): SPEC flow says the elder may also mark resolved; rules section says caretakers only. Decide in S5.
      allow update: if signedIn()
        && request.auth.uid in resource.data.caretaker_uids
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'ack_by', 'ack_at'])
        && request.resource.data.status in ['seen', 'calling', 'resolved'];
      allow delete: if false;
    }
  }
}
